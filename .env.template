# Copy this file to `.env` (in the solution root) and fill in your token(s).
# `.env` is gitignored and is automatically picked up by the `PackTS` MSBuild
# target, so `dotnet build -c Release -target:PackTS -v d -property:PublishTS=true`
# can authenticate with Thunderstore without setting a machine-wide env var.

# Thunderstore publish API key. Create one at:
# https://thunderstore.io/settings/teams/ (or your account -> "Publish API keys")
TCLI_AUTH_TOKEN=
